# Copy to .env.local and fill in after creating a Supabase project.

# Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Server-only — never expose to the browser. Required for npm run seed:supabase
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Auth setup in Supabase Dashboard:
# 1) Authentication → Providers → enable Google (client id/secret)
# 2) Authentication → Providers → enable Phone (Twilio / MessageBird / Vonage)
# 3) Authentication → URL config → add redirect:
#    http://localhost:3000/auth/callback
#    https://your-domain.com/auth/callback

# Optional: force data source. If unset, uses supabase when URL+anon exist, else demo.
# LEADERBOARD_DATA_SOURCE=demo
# LEADERBOARD_DATA_SOURCE=supabase

# Optional: number of seeded demo profiles (1–25)
# DEMO_PROFILE_COUNT=25
