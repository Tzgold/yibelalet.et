# Copy to .env.local and fill in after creating a Supabase project.

# Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Server-only — never expose to the browser. Required for npm run seed:supabase
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Prediction engine (server-side scripts only). Apply both Supabase migrations first.
# Optional: improves fixtures/standings coverage and bookmaker odds coverage.
FOOTBALL_DATA_ORG_TOKEN=
THE_ODDS_API_KEY=
THE_ODDS_API_MONTHLY_CREDITS=500
# Optional: bilingual written analysis. Without a key, picks use the statistical model.
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-opus-5-5
ANALYSIS_EFFORT=medium

# Local mock phone auth (no Twilio). Use OTP 123456 after register.
# AUTH_MOCK=true
# NEXT_PUBLIC_AUTH_MOCK=true

# Auth setup in Supabase Dashboard (when ready for real SMS):
# 1) Set AUTH_MOCK / NEXT_PUBLIC_AUTH_MOCK to false or remove them
# 2) Authentication → Providers → enable Phone (Twilio / MessageBird / Vonage)
# 3) Authentication → URL config → Site URL + redirect allow list as needed
#    http://localhost:3000
#    https://your-domain.com

# Force data source. If unset, uses supabase when URL+anon exist, else demo.
# Keep "demo" until you run migrations + seed against Supabase.
LEADERBOARD_DATA_SOURCE=demo
# LEADERBOARD_DATA_SOURCE=supabase

# Optional: number of seeded demo profiles (1–25)
# DEMO_PROFILE_COUNT=25

# Chapa — real subscribe checkout (https://dashboard.chapa.co → API Keys)
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxx
CHAPA_SUBSCRIBE_AMOUNT_ETB=99
CHAPA_SUBSCRIBE_DAYS=30
# Only enable mock to skip Chapa locally:
# CHAPA_MOCK=true
# NEXT_PUBLIC_CHAPA_MOCK=true

